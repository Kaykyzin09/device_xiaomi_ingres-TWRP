# Battery Property
# Permite que o carregador do recovery controle a suspensão durante a carga.
ro.charger.enable_suspend=1

# Storage
# Flags para identificar e montar o armazenamento emulado com quotas e casefolding.
external_storage.projid.enabled=1
external_storage.casefold.enabled=1
external_storage.sdcardfs.enabled=0

# Crypto
# Parâmetros de criptografia usados pelo Android para dados e nomes de arquivos.
ro.crypto.allow_encrypt_override=true
ro.crypto.dm_default_key.options_format.version=2
ro.crypto.volume.filenames_mode=aes-256-cts
ro.crypto.volume.metadata.method=dm-default-key

# Gatekeeper
# Desativa o caminho SPU do Gatekeeper específico desta plataforma.
vendor.gatekeeper.disable_spu=true

# USB
# Seleciona a implementação USB usada pelos serviços durante o recovery.
vendor.usb.use_ffs_mtp=1
